{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validation_piece (one file per producer in data/processed/validation/)",
  "type": "object",
  "required": ["schema_version", "generated_at", "producer", "metrics", "limitations"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "producer": {"type": "string"},
    "metrics": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "required": ["producer_revision", "input_hashes"],
      "properties": {
        "producer_revision": {"type": ["string", "null"]},
        "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    }
  }
}
